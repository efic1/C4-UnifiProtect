<devicedata>
  <copyright>2026</copyright>
  <creator>Efi</creator>
  <manufacturer>Ubiquiti</manufacturer>
  <name>UniFi Protect Camera (Standalone)</name>
  <model>UniFi Protect Camera</model>
  <created>09/10/2026</created>
  <modified>09/10/2026</modified>
  <version>46</version>
  <small>devices_sm/camera.gif</small>
  <large>devices_lg/camera.gif</large>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <config>
    <documentation file="www/documentation.html"/>
  <properties>
    <property>
      <name>Driver Version</name>
      <type>STRING</type>
      <readonly>true</readonly>
      <default></default>
    </property>
    <property>
      <name>Driver Status</name>
      <type>STRING</type>
      <readonly>true</readonly>
      <default>Not Configured</default>
    </property>
    <property>
      <name>Camera Name</name>
      <type>STRING</type>
      <readonly>true</readonly>
      <default></default>
    </property>

    <property>
      <name>NVR Address</name>
      <type>STRING</type>
      <readonly>false</readonly>
      <default></default>
      <description>IP address or hostname of the UniFi OS Console. Leave blank until configured.</description>
    </property>
    <property>
      <name>API Key</name>
      <type>STRING</type>
      <password>true</password>
      <readonly>false</readonly>
      <default></default>
    </property>
    <property>
      <name>Camera</name>
      <type>LIST</type>
      <readonly>false</readonly>
      <default>&lt;none&gt; - run Discover Cameras</default>
      <items>
        <item>&lt;none&gt; - run Discover Cameras</item>
      </items>
      <description>Select the camera. The list fills in after Discover Cameras runs, and refreshes on driver load.</description>
    </property>
    <property>
      <name>Camera ID</name>
      <type>STRING</type>
      <readonly>false</readonly>
      <default></default>
      <description>Set automatically when you pick a camera above. Editable in case discovery is unavailable.</description>
    </property>
    <property>
      <name>RTSP Alias - Low</name>
      <type>STRING</type>
      <readonly>false</readonly>
      <default></default>
      <description>Stream token for the low-resolution channel. Populated by "Fetch Stream Aliases".</description>
    </property>
    <property>
      <name>RTSP Alias - Medium</name>
      <type>STRING</type>
      <readonly>false</readonly>
      <default></default>
    </property>
    <property>
      <name>RTSP Alias - High</name>
      <type>STRING</type>
      <readonly>false</readonly>
      <default></default>
    </property>

    <property>
      <name>Enable RTSP Automatically</name>
      <type>LIST</type>
      <readonly>false</readonly>
      <default>Yes</default>
      <items>
        <item>Yes</item>
        <item>No</item>
      </items>
      <description>If this camera has no RTSP stream enabled in Protect, turn one on automatically. RTSP is off by default in Protect, per camera and per quality.</description>
    </property>
    <property>
      <name>RTSP Port</name>
      <type>STRING</type>
      <readonly>false</readonly>
      <default>7447</default>
      <description>Protect's plain RTSP port. The driver keeps the camera proxy on this value; change it here rather than on the Camera Properties tab.</description>
    </property>
    <property>
      <name>Preferred Quality</name>
      <type>LIST</type>
      <readonly>false</readonly>
      <default>Low</default>
      <items>
        <item>Low</item>
        <item>Medium</item>
        <item>High</item>
      </items>
      <description>Which Protect stream to serve when the client does not specify a size. Low is recommended for remote viewing over 4Sight.</description>
    </property>
    <property>
      <name>Snapshots</name>
      <type>LIST</type>
      <readonly>false</readonly>
      <default>Off</default>
      <items>
        <item>Off</item>
        <item>On</item>
      </items>
      <description>Camera thumbnails. The driver fetches frames from Protect using the API key and serves them from the controller, so no Protect username or password is needed.</description>
    </property>
    <property>
      <name>Snapshot Status</name>
      <type>STRING</type>
      <readonly>true</readonly>
      <default>Off</default>
    </property>
    <property>
      <name>Controller Address</name>
      <type>STRING</type>
      <readonly>false</readonly>
      <default></default>
      <description>Leave blank to detect automatically. Set only if thumbnails do not load.</description>
    </property>
    <property>
      <name>Event Polling Interval</name>
      <type>LIST</type>
      <readonly>false</readonly>
      <default>Off</default>
      <items>
        <item>Off</item>
        <item>1 Second</item>
        <item>2 Seconds</item>
        <item>5 Seconds</item>
        <item>10 Seconds</item>
        <item>15 Seconds</item>
        <item>30 Seconds</item>
        <item>60 Seconds</item>
      </items>
      <description>How often this camera is polled for events. Every camera driver polls independently, so on an 8-camera system 2 Seconds means roughly 14,400 console requests per hour. Set Off if you do not need Control4 events.</description>
    </property>
    <property>
      <name>Adaptive Polling</name>
      <type>LIST</type>
      <readonly>false</readonly>
      <default>Yes</default>
      <items><item>Yes</item><item>No</item></items>
      <description>Poll once per second for a short window after an event, then drop back to the interval above. Lets you set a slow baseline without losing detail while something is happening.</description>
    </property>
    <property>
      <name>Adaptive Burst</name>
      <type>RANGED_INTEGER</type>
      <readonly>false</readonly>
      <default>30</default>
      <minimum>5</minimum>
      <maximum>300</maximum>
      <description>Seconds of fast polling after an event.</description>
    </property>
    <property>
      <name>API Call Rate</name>
      <type>STRING</type>
      <readonly>true</readonly>
      <default>unknown</default>
      <description>Approximate console requests per hour from this camera.</description>
    </property>
    <property>
      <name>Detect Person</name>
      <type>LIST</type>
      <readonly>false</readonly>
      <default>Yes</default>
      <items><item>Yes</item><item>No</item></items>
    </property>
    <property>
      <name>Detect Vehicle</name>
      <type>LIST</type>
      <readonly>false</readonly>
      <default>Yes</default>
      <items><item>Yes</item><item>No</item></items>
    </property>
    <property>
      <name>Detect Animal</name>
      <type>LIST</type>
      <readonly>false</readonly>
      <default>No</default>
      <items><item>Yes</item><item>No</item></items>
    </property>
    <property>
      <name>Detect Package</name>
      <type>LIST</type>
      <readonly>false</readonly>
      <default>No</default>
      <items><item>Yes</item><item>No</item></items>
    </property>
    <property>
      <name>Event Hold Time</name>
      <type>RANGED_INTEGER</type>
      <readonly>false</readonly>
      <default>5</default>
      <minimum>1</minimum>
      <maximum>60</maximum>
      <description>Watchdog only. State clears on the event's end when Protect reports one.</description>
    </property>

    <property>
      <name>Log Mode</name>
      <type>LIST</type>
      <readonly>false</readonly>
      <default>Off</default>
      <items>
        <item>Off</item>
        <item>Print</item>
        <item>Log</item>
        <item>Print and Log</item>
      </items>
    </property>
    <property>
      <name>Log Level</name>
      <type>LIST</type>
      <readonly>false</readonly>
      <default>2 - Warning</default>
      <items>
        <item>0 - Fatal</item>
        <item>1 - Error</item>
        <item>2 - Warning</item>
        <item>3 - Info</item>
        <item>4 - Debug</item>
        <item>5 - Trace</item>
      </items>
      <description>Debug logging disables itself after 8 hours.</description>
    </property>
  </properties>
  <actions>
    <action>
      <name>Test Connection</name>
      <command>TestConnection</command>
    </action>
    <action>
      <name>Discover Cameras</name>
      <command>DiscoverCameras</command>
      <description>Logs every camera on the console with its ID, so you can paste one into Camera ID.</description>
    </action>
    <action>
      <name>Fetch Stream Aliases</name>
      <command>FetchAliases</command>
      <description>Reads the RTSP tokens for this camera and fills the alias properties.</description>
    </action>
    <action>
      <name>Enable RTSP Streams</name>
      <command>EnableRtsp</command>
      <description>Asks Protect to turn RTSP on for all three qualities on this camera (API Key mode only).</description>
    </action>
    <action>
      <name>Run Diagnostics</name>
      <command>Diagnostics</command>
      <description>Tests the snapshot URL the way Navigator does, checks the endpoint with a header as a control, and reports whether the stored stream tokens are still current.</description>
    </action>
    <action>
      <name>Show Stream URLs</name>
      <command>ShowUrls</command>
      <description>Prints the exact XML handed to the camera proxy.</description>
    </action>
    <action>
      <name>Simulate Motion</name>
      <command>SimulateMotion</command>
    </action>
    <action>
      <name>Simulate Person</name>
      <command>SimulatePerson</command>
    </action>
    <action>
      <name>Simulate Doorbell</name>
      <command>SimulateDoorbell</command>
    </action>
  </actions>
    <script file="driver.lua"/>
  </config>

  <proxies qty="1">
    <proxy proxybindingid="5001" name="UniFi Protect Camera">camera</proxy>
  </proxies>

  <capabilities>
    <!-- Legacy static-URL model, mirroring the Provision-ISR driver that is
         confirmed working remotely over 4Sight on this system.
         Dynamic streams is deliberately NOT declared: it hands the client a
         URL directly, which works on the LAN and fails remotely because
         Director never gets to tunnel it. -->
    <!-- Legacy static-URL path only. The stock Generic H.264 driver plays
         Protect's 7447 stream through this path, so it is proven to work.
         Dynamic streams is deliberately NOT declared: declaring it makes the
         proxy prefer dynamic URLs and skip the legacy path entirely.
         http_tunnel keeps Director in the media path for remote viewing. -->
    <requires_dynamic_snapshot_urls>true</requires_dynamic_snapshot_urls>
    <http_tunnel>True</http_tunnel>
    <modes>SNAPSHOT, H264</modes>

    <has_pan>False</has_pan>
    <has_pan_scan>False</has_pan_scan>
    <has_tilt>False</has_tilt>
    <has_tilt_scan>False</has_tilt_scan>
    <has_zoom>False</has_zoom>
    <has_home>False</has_home>
    <number_presets>0</number_presets>

    <default_http_port>443</default_http_port>
    <default_rtsp_port>7447</default_rtsp_port>
    <default_authentication_required>False</default_authentication_required>
    <address_readonly>False</address_readonly>
    <http_port_readonly>False</http_port_readonly>
    <show_test_url>True</show_test_url>
    <use_http_for_h264>False</use_http_for_h264>
  </capabilities>

  <connections>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>Camera</connectionname>
      <type>2</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <hidden>True</hidden>
      <classes>
        <class>
          <classname>CAMERA</classname>
        </class>
      </classes>
    </connection>
  </connections>



  <events>
    <event>
      <id>1</id>
      <name>Motion Detected</name>
      <description>Motion started</description>
    </event>
    <event>
      <id>2</id>
      <name>Motion Ended</name>
      <description>Motion has stopped on this camera.</description>
    </event>
    <event>
      <id>3</id>
      <name>Person Detected</name>
      <description>Protect classified a detection on this camera as a person.</description>
    </event>
    <event>
      <id>4</id>
      <name>Vehicle Detected</name>
      <description>Protect classified a detection on this camera as a vehicle.</description>
    </event>
    <event>
      <id>5</id>
      <name>Animal Detected</name>
      <description>Protect classified a detection on this camera as an animal.</description>
    </event>
    <event>
      <id>6</id>
      <name>Package Detected</name>
      <description>Protect detected a package on this camera.</description>
    </event>
    <event>
      <id>7</id>
      <name>Doorbell Pressed</name>
      <description>The doorbell button was pressed.</description>
    </event>
    <event>
      <id>8</id>
      <name>Camera Offline</name>
      <description>The camera stopped responding to the console.</description>
    </event>
    <event>
      <id>9</id>
      <name>Camera Online</name>
      <description>The camera reconnected to the console.</description>
    </event>
  </events>

</devicedata>
